# Medikiosk Patient Portal Frontend Environment Variables

# Backend API base URL:
# - For local development (direct or via Vite proxy):
#   Leave blank to use the Vite dev proxy ('/api' -> http://localhost:8000), or set explicitly:
#   VITE_API_URL=http://localhost:8000
#
# - For Vercel Production deployment:
#   Set this to the URL of your deployed FastAPI backend project:
#   VITE_API_URL=https://your-backend-project.vercel.app
VITE_API_URL=http://localhost:8000
