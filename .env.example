# Environment (development, staging, production)
ENVIRONMENT=development

# Database configuration
# For PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/health_db
# For SQLite (Local development zero-setup):
DATABASE_URL=sqlite+aiosqlite:///./health_db.sqlite

# MongoDB configuration (for flexible medical records & notes)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=health_db
MONGO_ENABLED=false

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend URLs (for CORS)
PATIENT_PORTAL_URL=http://localhost:5173
DOCTOR_DASHBOARD_URL=http://localhost:5174
# Additional allowed CORS origins (comma-separated, e.g. for Vercel production frontend)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Frontend Client Variable (apps/patient-portal)
VITE_API_URL=http://localhost:8000

# AI Pre-Consultation Summary & Multimodal OCR (Google Gemini)
# Optional: If unset, system uses built-in clinical fallback summarizer
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ABDM (Ayushman Bharat Digital Mission) Sandbox Integration (Health 4.0 Part A)
ABDM_ENV=sandbox
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIP_ID=MEDIKIOSK_HIP_01
ABDM_MOCK_MODE=true
